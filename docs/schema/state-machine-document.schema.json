{
  "$id": "https://example.com/state-machine-document.schema.json",
  "title": "StateMachineDocument",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "machine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identificador estable y único dentro del documento"
        },
        "name": {
          "type": "string"
        },
        "initialStateId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Identificador estable y único dentro del documento"
            },
            {
              "type": "null"
            }
          ],
          "description": "ID del estado inicial (null solo si no hay estados)"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Identificador estable y único dentro del documento"
              },
              "label": {
                "type": "string",
                "description": "Nombre corto mostrado dentro del nodo"
              },
              "type": {
                "default": "normal",
                "description": "\"final\" marca un estado terminal",
                "type": "string",
                "enum": [
                  "normal",
                  "final"
                ]
              },
              "subtitle": {
                "description": "Texto corto dibujado debajo del nodo",
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "description": "Detalle de negocio; no se dibuja, se ve en el inspector",
                "type": [
                  "string",
                  "null"
                ]
              },
              "parentId": {
                "description": "ID del estado padre que lo agrupa. Ausente = subestado suelto",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "description": "Identificador estable y único dentro del documento"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "description": "Subestados: lo que se dibuja"
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Identificador estable y único dentro del documento"
              },
              "from": {
                "type": "string",
                "minLength": 1,
                "description": "ID del estado origen"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "description": "ID del estado destino (la flecha apunta aquí)"
              },
              "label": {
                "description": "Etiqueta visible",
                "type": [
                  "string",
                  "null"
                ]
              },
              "event": {
                "description": "Evento que dispara la transición",
                "type": [
                  "string",
                  "null"
                ]
              },
              "condition": {
                "description": "Condición / guard",
                "type": [
                  "string",
                  "null"
                ]
              },
              "action": {
                "description": "Acción ejecutada al transicionar",
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "description": "Detalle de negocio; no se dibuja, se ve en el inspector",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "parents": {
          "description": "Estados padre que agrupan subestados; no se dibujan",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "Identificador estable y único dentro del documento"
              },
              "label": {
                "type": "string",
                "description": "Nombre del estado padre"
              },
              "description": {
                "description": "Detalle de negocio; no se dibuja",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "initialStateId",
        "states",
        "transitions"
      ],
      "additionalProperties": false
    },
    "layout": {
      "default": {},
      "type": "object",
      "properties": {
        "states": {
          "default": {},
          "description": "Centro de cada estado, indexado por ID de estado",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador estable y único dentro del documento"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "viewport": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "styles": {
      "default": {},
      "type": "object",
      "properties": {
        "defaults": {
          "default": {},
          "type": "object",
          "properties": {
            "stateColor": {
              "default": "#000000",
              "type": "string",
              "minLength": 1,
              "description": "Color CSS (preferentemente hexadecimal). Solo presentación."
            },
            "transitionColor": {
              "default": "#000000",
              "type": "string",
              "minLength": 1,
              "description": "Color CSS (preferentemente hexadecimal). Solo presentación."
            }
          },
          "additionalProperties": false
        },
        "states": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador estable y único dentro del documento"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "minLength": 1,
                "description": "Color CSS (preferentemente hexadecimal). Solo presentación."
              }
            },
            "additionalProperties": false
          }
        },
        "transitions": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador estable y único dentro del documento"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "minLength": 1,
                "description": "Color CSS (preferentemente hexadecimal). Solo presentación."
              },
              "curvature": {
                "description": "Curvatura en [-1, 1]; 0 = recta; ausente = automática",
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "lineStyle": {
                "type": "string",
                "enum": [
                  "solid",
                  "dashed"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "machine"
  ],
  "additionalProperties": false,
  "description": "Documento de máquina de estados: machine (semántica) + layout + styles"
}
