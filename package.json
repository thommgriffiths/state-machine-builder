{
  "name": "state-machine-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editor web de máquinas de estado con separación estricta entre modelo semántico, layout y estilos.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "schema": "tsx scripts/generate-json-schema.ts",
    "validate": "tsx scripts/validate-document.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "marked": "^18.0.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
